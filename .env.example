# Copia este archivo a ".env" y completa tus propios valores reales.
# El archivo ".env" NUNCA se sube al repositorio (ver .gitignore).

# --- Obligatorio: al menos un proveedor de IA. Gemini es gratis. ---
GEMINI_API_KEY=tu-key-aqui

# --- Clave secreta de Flask (para firmar cookies de sesión/flash) ---
# Genera una aleatoria con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Acceso a la app web ---
APP_USERNAME=admin
APP_PASSWORD=una-contraseña-segura

# --- Opcional: otros proveedores de IA ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Opcional: respaldo automático en Google Drive ---
# DRIVE_SYNC_FOLDER=/ruta/a/tu/carpeta/de/Drive

# --- Opcional: alertas por correo de ítems críticos ---
# ALERTA_SMTP_HOST=smtp.gmail.com
# ALERTA_SMTP_PORT=587
# ALERTA_SMTP_USER=tu_correo@gmail.com
# ALERTA_SMTP_PASS=tu-contraseña-de-aplicación
# ALERTA_EMAIL_TO=quien-debe-recibir-la-alerta@dropi.co

# --- Opcional: meta de calidad por defecto del dashboard (0.85 = 85%) ---
# META_CALIDAD=0.85
